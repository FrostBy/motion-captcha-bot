# Telegram bot token from @BotFather. Required.
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Seconds a newcomer has to answer before a temporary ban.
CAPTCHA_TIMEOUT_SEC=60

# Noise look: l = 2px bands (default), g = 1px bands, dots = sparse dots.
CAPTCHA_STYLE=l

# Motion: 1 = layers move in opposite directions (default),
# 2 = same direction with wobbling speeds (anti shift-matching).
CAPTCHA_MOTION=1

# Share of pixels re-seeded with fresh noise each frame, 0..1 (0 = off).
# Hampers automated frame analysis at the cost of readability and file size.
CAPTCHA_SPRINKLE=0

# Bake a faint fake expression into the field; answering it triggers the ban.
CAPTCHA_DECOY=false

# Wrong numeric answers allowed before the ban (chatter is not counted).
CAPTCHA_MAX_ATTEMPTS=3

# Seconds a failed newcomer remains banned (60..31536000).
CAPTCHA_BAN_SEC=300

# What a rendering failure means. false lets the newcomer in, true bans them
# for CAPTCHA_BAN_SEC so a broken renderer cannot become a way past the captcha.
CAPTCHA_FAIL_CLOSED=false

# Days a passed user is remembered; 0 keeps them forever.
PASSED_TTL_DAYS=0

# Digits per operand. 1 keeps the glyphs large and the arithmetic instant;
# 2 widens the answer space from 19 sums to about 180, at the price of a
# smaller glyph and more thinking for the newcomer.
CAPTCHA_OPERAND_DIGITS=1

# Bots allowed regardless of who added them (comma-separated numeric IDs).
# ALLOWED_BOT_IDS=123456789,987654321

# Chats served by the bot; empty allows all (comma-separated numeric IDs).
# ALLOWED_CHAT_IDS=-1001234567890,-1009876543210

# State snapshot location. Keep it on a volume in Docker.
DATA_FILE=data/state.json

# Optional JSON with message templates (%username%, %timer% placeholders).
MESSAGES_FILE=data/messages.json

# ffmpeg binary path. The Docker image ships its own; set for local runs.
FFMPEG_PATH=ffmpeg

# Talk to Telegram's test environment instead of production.
TELEGRAM_TEST_MODE=false

# Optional Bot API root for compatible servers such as Telegym.
# TELEGRAM_API_ROOT=http://127.0.0.1:5678

# Deterministic captcha PRNG seed for integration tests only. Requires TELEGRAM_API_ROOT.
# CAPTCHA_TEST_SEED=42
